<TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         x:Name="tabAutopilot" Header="&#x1F4BB; Autopilot">
    <TabItem.Resources>
        <!--HU:THEME-->
        <Style x:Key="ApRowStatus" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Bereit"><Setter Property="Background" Value="#1B3A1F"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Fehlt"><Setter Property="Background" Value="#4A1C1C"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Fehler"><Setter Property="Background" Value="#4A1C1C"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warnung"><Setter Property="Background" Value="#4A3B12"/></DataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Status}" Value="Bereit"/><Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="1"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="#24482A"/></MultiDataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Status}" Value="Fehlt"/><Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="1"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="#582323"/></MultiDataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Status}" Value="Fehler"/><Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="1"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="#582323"/></MultiDataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Status}" Value="Warnung"/><Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="1"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="#584718"/></MultiDataTrigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#094771"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ApRowArchiv" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HashDa}" Value="nein"><Setter Property="Background" Value="#4A3B12"/></DataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HashDa}" Value="nein"/><Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex)}" Value="1"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="#584718"/></MultiDataTrigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#094771"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ApRowAuf" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Ampel}" Value="gut"><Setter Property="Background" Value="#1B3A1F"/></DataTrigger>
                <DataTrigger Binding="{Binding Ampel}" Value="warn"><Setter Property="Background" Value="#4A3B12"/></DataTrigger>
                <DataTrigger Binding="{Binding Ampel}" Value="fehler"><Setter Property="Background" Value="#4A1C1C"/></DataTrigger>
                <DataTrigger Binding="{Binding Ampel}" Value="grau"><Setter Property="Foreground" Value="#888888"/></DataTrigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#094771"/></Trigger>
            </Style.Triggers>
        </Style>
    </TabItem.Resources>
    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="140" MinHeight="50"/>
        </Grid.RowDefinitions>

        <!-- Kopf: Tenants + Laden -->
        <Border Grid.Row="0" Background="#252526" CornerRadius="4" Padding="10" Margin="0,0,0,6">
            <DockPanel>
                <Button x:Name="apBtnLaden" DockPanel.Dock="Right" VerticalAlignment="Center" Content="Laden" Width="100" Background="#1976D2" Style="{StaticResource DarkButton}"
                        ToolTip="Uebersicht/Tags: markierte Tenants lesen. Hash-Archiv/Ausscheiden: Geraete des gewaehlten Tenants lesen. Aufnehmen: Tags, Gruppen, Profile und Rechte des Tenants lesen. Aendert nichts."/>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Autopilot" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="apTxtVersion" FontSize="10" Foreground="#4CAF50" VerticalAlignment="Center" Margin="8,1,0,0"/>
                    </StackPanel>
                    <WrapPanel x:Name="apTenants" Margin="0,2,0,0"
                               ToolTip="Uebersicht und Tags &amp; Gruppen: mehrere Tenants gleichzeitig"/>
                    <StackPanel x:Name="apEinTenant" Orientation="Horizontal" Margin="0,2,0,0" Visibility="Collapsed">
                        <TextBlock Text="Tenant" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="apCmbTenant" Style="{StaticResource DarkComboBox}" Width="180"
                                  ToolTip="Hash-Archiv, Aufnehmen und Ausscheiden arbeiten immer in einem Tenant - die Auswahl gilt fuer alle drei Reiter"/>
                        <TextBlock Text="gilt fuer Hash-Archiv, Aufnehmen und Ausscheiden" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <Border x:Name="apRechteBanner" Visibility="Collapsed" Background="#4A3B12" CornerRadius="4" Padding="8,4" Margin="0,6,0,0">
                        <DockPanel>
                            <Button x:Name="apBtnRechte" DockPanel.Dock="Right" Content="Rechte erteilen ..." Background="#B85C00" Style="{StaticResource DarkButton}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                                    ToolTip="Ein Global Administrator meldet sich je Tenant einmal im Browser an - die fehlenden Rechte sind vorausgewaehlt"/>
                            <TextBlock x:Name="apTxtRechte" Foreground="#FFE0B2" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" x:Name="apTabs" Style="{StaticResource DarkTabControl}">
            <!-- Uebersicht -->
            <TabItem Header="Uebersicht" Style="{StaticResource DarkTabItem}">
                <DockPanel Margin="0,6,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button x:Name="apBtnClear" DockPanel.Dock="Right" Content="Ergebnis leeren" Background="#3E3E42" Style="{StaticResource ToolButton}" VerticalAlignment="Center"
                                Foreground="#CCCCCC" FontSize="11" Padding="8,1" Margin="12,0,0,0" ToolTip="Geraete der markierten Tenants aus der Tabelle entfernen"/>
                        <Button x:Name="apBtnTagUndo" DockPanel.Dock="Right" Content="Tag-Aenderung rueckgaengig ..." Background="#3E3E42" Style="{StaticResource ToolButton}" Foreground="#CCCCCC" FontSize="11" Padding="8,1" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                ToolTip="Die zuletzt geaenderten Geraete wieder auf ihren vorherigen Group Tag setzen"/>
                        <Button x:Name="apBtnTag" DockPanel.Dock="Right" Content="Tag aendern ..." Background="#B85C00" Style="{StaticResource DarkButton}" VerticalAlignment="Center" FontSize="11" Margin="12,0,0,0"
                                ToolTip="Group Tag der markierten Geraete aendern (ein Tenant) - mit Pruefung von Gruppe und Profil und Bestaetigung"/>
                        <Button x:Name="apBtnTable" DockPanel.Dock="Right" Content="&#x1F4CA; Tabelle / Export" Background="#3E3E42" Style="{StaticResource DarkButton}" VerticalAlignment="Center" FontSize="11" Margin="12,0,0,0"
                                ToolTip="Angezeigte Zeilen als Tabelle oeffnen und exportieren (Excel/CSV) - mit Benutzer (UPN), ohne Hash"/>
                        <CheckBox x:Name="apChkNurProbleme" DockPanel.Dock="Right" Content="nur nicht bereit" Style="{StaticResource DarkCheckBox}" VerticalAlignment="Center" Margin="12,0,0,0"
                                  ToolTip="nur Geraete, die nicht bereit fuer die Ausgabe sind (kein Profil, ohne Group Tag, Fehler)"/>
                        <CheckBox x:Name="apChkOhneIntune" DockPanel.Dock="Right" Content="nur ohne Intune" Style="{StaticResource DarkCheckBox}" VerticalAlignment="Center"
                                  ToolTip="nur Geraete, die in Autopilot stehen, aber (noch) nicht in Intune verwaltet werden"/>
                        <TextBlock DockPanel.Dock="Left" Text="Filter:" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="apTxtFilter" DockPanel.Dock="Left" VerticalAlignment="Center" Width="220" Style="{StaticResource DarkTextBox}" FontSize="12" Margin="0,0,12,0"
                                 ToolTip="Text in Seriennummer, Modell, Group Tag, Geraetename, Status ... (mehrere Woerter: alle muessen vorkommen)"/>
                        <Ellipse x:Name="apDotLaden" DockPanel.Dock="Left" Width="10" Height="10" Fill="#4CAF50" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="laeuft ..."/>
                        <TextBlock x:Name="apTxtSumme" Style="{StaticResource HintText}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="Tenants markieren und Laden klicken."/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintText}" Margin="0,4,0,0" Text="Doppelklick: alle Details"/>
                    <DataGrid x:Name="apGrid" Style="{StaticResource DarkDataGrid}" AutoGenerateColumns="False" RowStyle="{StaticResource ApRowStatus}" AlternationCount="2" SelectionMode="Extended" IsReadOnly="True" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tenant" Binding="{Binding TenantName}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Seriennummer" Binding="{Binding Seriennummer}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Hersteller" Binding="{Binding Hersteller}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Modell" Binding="{Binding Modell}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Group Tag" Binding="{Binding GroupTag}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Profil" Binding="{Binding Profil}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Registrierung" Binding="{Binding Registrierung}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="In Intune" Binding="{Binding InIntune}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Geraetename" Binding="{Binding Geraetename}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Benutzer (UPN)" Binding="{Binding Benutzer}" Width="Auto" MaxWidth="360"/>
                            <DataGridTextColumn Binding="{Binding EingerichtetAm}" Width="Auto" MaxWidth="320" SortMemberPath="EingerichtetAm">
                                <DataGridTextColumn.Header><TextBlock Text="Eingerichtet am" ToolTip="Wann das Geraet in Intune eingerichtet wurde (Autopilot selbst liefert kein Registrierungsdatum). Klick auf eine Spalte sortiert, nochmals Klick dreht um."/></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Letzter Kontakt" Binding="{Binding LetzterKontakt}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Letzter Sync" Binding="{Binding LetzterSync}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Hinweis" Binding="{Binding Hinweis}" Width="Auto" MaxWidth="600"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Tags & Gruppen (Stufe 1: nur Zahlen je Group Tag) -->
            <TabItem Header="Tags &amp; Gruppen" Style="{StaticResource DarkTabItem}">
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintText}" Margin="0,0,0,4" TextWrapping="Wrap"
                               Text="Group Tags aus der letzten Ladung (Gross/klein gilt als gleich, wie in den dynamischen Gruppen). Gruppen und Profile je Tag sowie Tag aendern folgen in Stufe 2."/>
                    <DataGrid x:Name="apGridTags" Style="{StaticResource DarkDataGrid}" AutoGenerateColumns="False" AlternationCount="2" SelectionMode="Extended" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tenant" Binding="{Binding TenantName}" Width="Auto"/>
                            <DataGridTextColumn Header="Group Tag" Binding="{Binding GroupTag}" Width="Auto"/>
                            <DataGridTextColumn Header="Geraete" Binding="{Binding Geraete}" Width="Auto"/>
                            <DataGridTextColumn Header="Bereit" Binding="{Binding Bereit}" Width="Auto"/>
                            <DataGridTextColumn Header="Ohne Profil" Binding="{Binding OhneProfil}" Width="Auto"/>
                            <DataGridTextColumn Header="In Intune" Binding="{Binding InIntune}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Aufnehmen (Stufe 3) -->
            <TabItem Header="Aufnehmen" Style="{StaticResource DarkTabItem}">
                <DockPanel Margin="0,6,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Ellipse x:Name="apDotAuf" Width="10" Height="10" Fill="#4CAF50" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="laeuft ..."/>
                        <Rectangle Width="10"/>
                        <CheckBox x:Name="apChkAufAlle" Content="auch registrierte/ausgeschiedene" Style="{StaticResource DarkCheckBox}" VerticalAlignment="Center" Margin="0,0,12,0"
                                  ToolTip="Auch Geraete aus dem Archiv zeigen, die schon in Autopilot stehen oder als ausgeschieden gekennzeichnet sind (werden nicht importiert)"/>
                        <TextBlock Text="Filter:" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="apTxtAufFilter" Width="200" Style="{StaticResource DarkTextBox}" FontSize="12" Margin="0,0,8,0"
                                 ToolTip="Text in Seriennummer, Lieferung, Status, Tag (mehrere Woerter: alle muessen vorkommen)"/>
                        <Button x:Name="apBtnAufAlleNeu" Content="Alle neuen markieren" Background="#3E3E42" Style="{StaticResource ToolButton}" Foreground="#CCCCCC" FontSize="11" Padding="8,1" Margin="0,0,6,0"
                                ToolTip="Alle angezeigten Geraete markieren, die noch in keinem Autopilot stehen"/>
                    </WrapPanel>
                    <Border x:Name="apAufRechte" DockPanel.Dock="Top" Visibility="Collapsed" Background="#4A3B12" CornerRadius="4" Padding="8,4" Margin="0,0,0,6">
                        <DockPanel>
                            <Button x:Name="apBtnAufRechte" DockPanel.Dock="Right" Content="Rechte erteilen ..." Background="#B85C00" Style="{StaticResource DarkButton}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                                    ToolTip="Ein Global Administrator meldet sich einmal im Browser an - die fehlenden Rechte sind vorausgewaehlt"/>
                            <TextBlock x:Name="apTxtAufRechte" Foreground="#FFE0B2" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Background="#252526" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="1. Group Tag" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,6"/>
                            <WrapPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                                <TextBox x:Name="apTxtAufTagEingabe" Width="160" Style="{StaticResource DarkTextBox}" FontSize="12" Margin="0,0,6,0"
                                         ToolTip="Group Tag eintippen - erlaubt: Buchstaben, Ziffern, - und _"/>
                                <ComboBox x:Name="apCmbAufTag" Style="{StaticResource DarkComboBox}" Width="160" Margin="0,0,10,0"
                                          ToolTip="Vorhandenen Tag waehlen (aus den Geraeten und den Regeln dynamischer Gruppen) - wird links eingetragen"/>
                                <TextBlock x:Name="apTxtAufTag" Foreground="#AAAAAA" VerticalAlignment="Center" TextWrapping="Wrap" Text="Zuerst oben 'Laden' klicken."/>
                            </WrapPanel>
                            <TextBlock Grid.Row="1" Text="2. Gruppe" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,6"/>
                            <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                                <TextBlock x:Name="apTxtAufGruppe" Foreground="#CCCCCC" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" Text="-"/>
                                <TextBox x:Name="apTxtAufGruppeName" Width="200" Style="{StaticResource DarkTextBox}" FontSize="12" Margin="0,0,6,0" Visibility="Collapsed"
                                         ToolTip="Name der neuen dynamischen Gruppe"/>
                                <Button x:Name="apBtnAufGruppeNeu" Content="Gruppe anlegen ..." Background="#B85C00" Style="{StaticResource DarkButton}" FontSize="11" Margin="0,0,6,0" Visibility="Collapsed"
                                        ToolTip="Dynamische Sicherheitsgruppe mit der Regel (device.devicePhysicalIds -any (_ -eq &quot;[OrderID]:Tag&quot;)) anlegen"/>
                                <Button x:Name="apBtnAufGruppeWeg" Content="Angelegte Gruppe loeschen ..." Background="#3E3E42" Style="{StaticResource ToolButton}" Foreground="#CCCCCC" FontSize="11" Padding="8,1" Visibility="Collapsed"
                                        ToolTip="Rueckgaengig: die eben von der App angelegte Gruppe wieder loeschen (nur solche mit 'angelegt von HU-MultiTenant')"/>
                            </WrapPanel>
                            <TextBlock Grid.Row="2" Text="3. Profil" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="apTxtAufProfil" Foreground="#CCCCCC" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6" Text="-"/>
                            <TextBlock Grid.Row="3" Text="4. Import" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <WrapPanel Grid.Row="3" Grid.Column="1">
                                <Button x:Name="apBtnAufImport" Content="Vorschau &amp; Import ..." Width="170" Background="#B85C00" Style="{StaticResource DarkButton}" Margin="0,0,8,0"
                                        ToolTip="Markierte Geraete mit dem Tag in Autopilot importieren - vorher Vorschau und Bestaetigung mit dem Tenant-Namen"/>
                                <Button x:Name="apBtnAufStatus" Content="Status pruefen" Width="120" Background="#1976D2" Style="{StaticResource DarkButton}" Margin="0,0,8,0"
                                        ToolTip="Autopilot-Eintrag, Gruppenmitgliedschaft und Profilstatus der zuletzt importierten Geraete lesen"/>
                                <CheckBox x:Name="apChkAufAuto" Content="alle 2 Minuten" Style="{StaticResource DarkCheckBox}" VerticalAlignment="Center" IsChecked="True" Margin="0,0,12,0"
                                          ToolTip="Status nach dem Import automatisch alle 2 Minuten pruefen, bis alle Geraete ein Profil haben (hoechstens 2 Stunden)"/>
                                <TextBlock x:Name="apTxtAufSumme" Style="{StaticResource HintText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <DataGrid x:Name="apGridAuf" Style="{StaticResource DarkDataGrid}" AutoGenerateColumns="False" RowStyle="{StaticResource ApRowAuf}" AlternationCount="2" SelectionMode="Extended" IsReadOnly="True" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Seriennummer" Binding="{Binding Seriennummer}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" MaxWidth="420"/>
                            <DataGridTextColumn Header="Tag jetzt" Binding="{Binding TagJetzt}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Tag (Datei)" Binding="{Binding TagDatei}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Lieferung" Binding="{Binding Lieferung}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Eingelesen" Binding="{Binding Eingelesen}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Import" Binding="{Binding Import}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="In Gruppe" Binding="{Binding InGruppe}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Profil" Binding="{Binding Profil}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Dauer bis Gruppe" Binding="{Binding DauerGruppe}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Dauer bis Profil" Binding="{Binding DauerProfil}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Hinweis" Binding="{Binding Hinweis}" Width="Auto" MaxWidth="600"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Ausscheiden" Style="{StaticResource DarkTabItem}">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="80"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*" MinHeight="80"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <Border x:Name="apAusRechte" Visibility="Collapsed" Background="#4A3B12" CornerRadius="4" Padding="8,4" Margin="0,0,0,6">
                            <DockPanel>
                                <Button x:Name="apBtnAusRechte" DockPanel.Dock="Right" Content="Rechte erteilen ..." Background="#B85C00" Style="{StaticResource DarkButton}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                                        ToolTip="Ein Global Administrator meldet sich einmal im Browser an - die fehlenden Rechte sind vorausgewaehlt"/>
                                <TextBlock x:Name="apTxtAusRechte" Foreground="#FFE0B2" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <DockPanel Margin="0,0,0,6" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="apBtnAusListe" Content="Liste ..." Width="90" Background="#1976D2" Style="{StaticResource DarkButton}" Margin="0,0,8,0"
                                        ToolTip="Abgaengerliste (CSV, Excel oder Text mit Seriennummern oder UPNs) einlesen - die passenden Geraete werden markiert. Die Datei kann auch auf die Tabelle gezogen werden."/>
                                <Button x:Name="apBtnAusZur" Content="Zurueckziehen ..." Width="150" Background="#B85C00" Style="{StaticResource DarkButton}" Margin="0,0,8,0"
                                        ToolTip="Geraet bleibt bei der Familie: BitLocker-Schluessel lesen, Autopilot-Eintrag entfernen, Zurueckziehen (Daten bleiben). Uebergabe-Bestaetigung zum Drucken."/>
                                <Button x:Name="apBtnAusStart" Content="Ausscheiden ..." Width="150" Background="#B85C00" Style="{StaticResource DarkButton}"
                                        ToolTip="Markierte Geraete ausscheiden: Benutzer im Autopilot-Eintrag aufheben, Autopilot-Eintrag entfernen, warten bis er weg ist, dann Wipe. Mit Vorschau und Bestaetigung."/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Suche:" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="apTxtAusFilter" Width="260" Style="{StaticResource DarkTextBox}" FontSize="12" Margin="0,0,12,0"
                                         ToolTip="Seriennummer, Geraetename, Benutzer (UPN), Group Tag - mehrere Woerter: alle muessen vorkommen"/>
                                <Ellipse x:Name="apDotAus" Width="10" Height="10" Fill="#4CAF50" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="laeuft ..."/>
                                <TextBlock x:Name="apTxtAusSumme" Style="{StaticResource HintText}" VerticalAlignment="Center" Text="Oben 'Laden' klicken."/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="apGridAus" AllowDrop="True" Style="{StaticResource DarkDataGrid}" AutoGenerateColumns="False" RowStyle="{StaticResource ApRowAuf}" AlternationCount="2" SelectionMode="Extended" IsReadOnly="True" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Seriennummer" Binding="{Binding Seriennummer}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Geraetename" Binding="{Binding Geraetename}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Benutzer (UPN)" Binding="{Binding Benutzer}" Width="Auto" MaxWidth="360"/>
                            <DataGridTextColumn Header="Group Tag" Binding="{Binding GroupTag}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="In Intune" Binding="{Binding InIntune}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Eigentum" Binding="{Binding Eigentum}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Letzter Sync" Binding="{Binding LetzterSync}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Hash im Archiv" Binding="{Binding HashDa}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Pruefung" Binding="{Binding Pruefung}" Width="Auto" MaxWidth="700"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="#3E3E42"/>
                    <DockPanel Grid.Row="3">
                        <DockPanel DockPanel.Dock="Top" Margin="0,6,0,4" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="Nachverfolgung" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <CheckBox DockPanel.Dock="Left" x:Name="apChkAusErledigt" Content="auch abgeschlossene" Style="{StaticResource DarkCheckBox}" VerticalAlignment="Center"
                                      ToolTip="Auch Vorgaenge zeigen, deren Intune-Eintrag schon geloescht ist"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="apBtnAusStatus" Content="Status pruefen" Width="120" Background="#1976D2" Style="{StaticResource DarkButton}" Margin="0,0,8,0"
                                        ToolTip="Wipe-Status und Intune-Eintrag der offenen Vorgaenge lesen (aendert nichts)"/>
                                <Button x:Name="apBtnAusSync" Content="Sync senden" Width="110" Background="#1976D2" Style="{StaticResource DarkButton}" Margin="0,0,8,0"
                                        ToolTip="Markierte Geraete auffordern, sich sofort bei Intune zu melden (holt einen ausstehenden Wipe schneller ab - hilft nicht bei ausgeschalteten Geraeten)"/>
                                <Button x:Name="apBtnAusNochmal" Content="Erneut versuchen ..." Background="#B85C00" Style="{StaticResource DarkButton}" Margin="0,0,8,0"
                                        ToolTip="Markierte Vorgaenge ohne Wipe (Autopilot-Eintrag war noch da) erneut pruefen und dann den Wipe senden"/>
                                <Button x:Name="apBtnAusIntune" Content="Intune-Eintrag loeschen ..." Background="#B85C00" Style="{StaticResource DarkButton}" Margin="0,0,8,0"
                                        ToolTip="Fuer markierte Vorgaenge mit erledigtem Wipe den Intune-Eintrag loeschen (Entra-Objekt bleibt)"/>
                                <Button x:Name="apBtnAusPaket" Content="Pakete fuer Eltern ..." Background="#3E3E42" Style="{StaticResource DarkButton}" FontSize="11" Margin="0,0,8,0"
                                        ToolTip="Fuer markierte Vorgaenge je Geraet ein ZIP (Protokoll, Import-CSV fuer die neue Schule, Hinweis fuer die Eltern) plus Uebersicht und Mailtext - ohne BitLocker-Schluessel"/>
                                <Button x:Name="apBtnAusOrdner" Content="Protokolle ..." Background="#3E3E42" Style="{StaticResource DarkButton}" FontSize="11"
                                        ToolTip="Ordner mit Ausscheidungsprotokollen und Import-CSV oeffnen"/>
                            </StackPanel>
                        </DockPanel>
                        <DataGrid x:Name="apGridAusVorgang" Style="{StaticResource DarkDataGrid}" AutoGenerateColumns="False" RowStyle="{StaticResource ApRowAuf}" AlternationCount="2" SelectionMode="Extended" IsReadOnly="True" CanUserSortColumns="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Art" Binding="{Binding Art}" Width="Auto" MaxWidth="320"/>
                                <DataGridTextColumn Header="Seriennummer" Binding="{Binding Seriennummer}" Width="Auto" MaxWidth="320"/>
                                <DataGridTextColumn Header="Geraetename" Binding="{Binding Geraetename}" Width="Auto" MaxWidth="320"/>
                                <DataGridTextColumn Header="Benutzer (UPN)" Binding="{Binding Benutzer}" Width="Auto" MaxWidth="360"/>
                                <DataGridTextColumn Header="Gestartet" Binding="{Binding Start}" Width="Auto" MaxWidth="320"/>
                                <DataGridTextColumn Header="Autopilot" Binding="{Binding Autopilot}" Width="Auto" MaxWidth="320"/>
                                <DataGridTextColumn Header="Wipe / Zurueckziehen" Binding="{Binding Wipe}" Width="Auto" MaxWidth="320"/>
                                <DataGridTextColumn Header="Intune" Binding="{Binding Intune}" Width="Auto" MaxWidth="320"/>
                                <DataGridTextColumn Header="Zuletzt geprueft" Binding="{Binding Geprueft}" Width="Auto" MaxWidth="320"/>
                                <DataGridTextColumn Header="Hinweis" Binding="{Binding Hinweis}" Width="Auto" MaxWidth="700"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Hash-Archiv" Style="{StaticResource DarkTabItem}">
                <DockPanel Margin="0,6,0,0">
                    <!-- Zeile 1: Hashes ins Archiv bringen -->
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button x:Name="apBtnArchivDatei" Content="Dateien hinzufuegen ..." Width="160" Background="#1976D2" Style="{StaticResource DarkButton}" Margin="0,0,8,0"
                                ToolTip="CSV- oder Excel-Dateien mit Hardware-Hash (Lieferant, Get-WindowsAutopilotInfo) ins Archiv uebernehmen - oder einfach auf die Flaeche unten ziehen"/>
                        <Button x:Name="apBtnArchivAbholen" Content="Hashes abholen" Width="130" Background="#1976D2" Style="{StaticResource DarkButton}" Margin="0,0,8,0"
                                ToolTip="Ergebnisse der Wartung HU-AP-Hash lesen und gueltige Hashes ins Archiv uebernehmen (aendert nichts in Intune)"/>
                        <Button x:Name="apBtnArchivWartung" Content="Hash anfordern ..." Width="140" Background="#B85C00" Style="{StaticResource DarkButton}" Margin="0,0,8,0"
                                ToolTip="Wartung HU-AP-Hash jetzt auf den markierten Geraeten ausfuehren (bzw. auf allen Autopilot-Geraeten ohne Hash) - legt das Paket bei Bedarf an (ohne Zuweisung)"/>
                        <Ellipse x:Name="apDotArchiv" Width="10" Height="10" Fill="#4CAF50" Margin="4,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="laeuft ..."/>
                    </WrapPanel>
                    <!-- Zeile 2: Anzeige filtern (links) und markierte Geraete bearbeiten (rechts) -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Markierte:" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" Margin="0,0,0,0"/>
                            <Button x:Name="apBtnArchivExport" Content="Export CSV ..." Background="#3E3E42" Style="{StaticResource DarkButton}" FontSize="11" Margin="8,0,0,0" ToolTip="Markierte Geraete im Microsoft-Format (Seriennummer, Product ID, Hash) als CSV speichern - die Datei ist NICHT verschluesselt"/>
                            <Button x:Name="apBtnArchivAus" Content="Ausgeschieden ..." Background="#3E3E42" Style="{StaticResource DarkButton}" FontSize="11" Margin="8,0,0,0" ToolTip="Markierte Geraete als ausgeschieden kennzeichnen (z. B. Abgaenger) - der Hash bleibt im Archiv, beim Aufnehmen werden sie nicht mehr angeboten"/>
                            <Button x:Name="apBtnArchivAusWeg" Content="Ausgeschieden aufheben" Background="#3E3E42" Style="{StaticResource DarkButton}" FontSize="11" Margin="8,0,0,0" ToolTip="Kennzeichnung 'ausgeschieden' der markierten Geraete entfernen (Geraet kommt zurueck)"/>
                            <Button x:Name="apBtnArchivEntfernen" Content="Entfernen ..." Background="#3E3E42" Style="{StaticResource DarkButton}" FontSize="11" Margin="8,0,0,0" ToolTip="Markierte Geraete mit allen Hashes aus dem Archiv loeschen"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="apChkArchivFehlt" Content="auch Autopilot-Geraete ohne Hash" Style="{StaticResource DarkCheckBox}" VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="True"
                                  ToolTip="Abgleich: Autopilot-Geraete des Tenants (aus der Uebersicht), fuer die noch kein Hash im Archiv liegt, mit anzeigen"/>
                            <CheckBox x:Name="apChkArchivNicht" Content="nur nicht in Autopilot" Style="{StaticResource DarkCheckBox}" VerticalAlignment="Center" Margin="0,0,12,0"
                                  ToolTip="Nur Geraete mit Hash zeigen, die in keinem Autopilot dieses Tenants (mehr) stehen - z. B. Abgaenger. Zum gezielten Markieren und Entfernen."/>
                            <TextBlock Text="Filter:" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="apTxtArchivFilter" Width="200" Style="{StaticResource DarkTextBox}" FontSize="12" Margin="0,0,8,0"
                                 ToolTip="Text in Seriennummer, Lieferung, Quelle, Geraetename, Group Tag (mehrere Woerter: alle muessen vorkommen)"/>
                        </StackPanel>
                    </DockPanel>
                    <Border x:Name="apDropArchiv" DockPanel.Dock="Top" AllowDrop="True" Height="44" BorderBrush="#555555" BorderThickness="2" CornerRadius="6" Background="#252526" Margin="0,0,0,4"
                            ToolTip="CSV- und Excel-Dateien oder ganze Ordner hierher ziehen">
                        <TextBlock x:Name="apTxtDrop" Text="CSV / Excel / Ordner mit Hardware-Hashes hierher ziehen" Foreground="#AAAAAA" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="apTxtArchivSumme" DockPanel.Dock="Top" Style="{StaticResource HintText}" Margin="0,0,0,4" TextWrapping="Wrap"
                               Text="Archiv verschluesselt nur fuer diesen Windows-Benutzer - auf einen anderen PC nur ueber die App-Sicherung."/>
                    <DataGrid x:Name="apGridArchiv" Style="{StaticResource DarkDataGrid}" AutoGenerateColumns="False" RowStyle="{StaticResource ApRowArchiv}" AlternationCount="2" SelectionMode="Extended" IsReadOnly="True" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Seriennummer" Binding="{Binding Seriennummer}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Hash" Binding="{Binding HashDa}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Anzahl" Binding="{Binding Anzahl}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Quelle" Binding="{Binding Quelle}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Lieferung" Binding="{Binding Lieferung}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Eingelesen" Binding="{Binding Eingelesen}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="In Autopilot" Binding="{Binding InAutopilot}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Geraetename" Binding="{Binding Geraetename}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Benutzer (UPN)" Binding="{Binding Benutzer}" Width="Auto" MaxWidth="360"/>
                            <DataGridTextColumn Header="Group Tag" Binding="{Binding GroupTag}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Modell" Binding="{Binding Modell}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Eingerichtet am" Binding="{Binding Eingerichtet}" Width="Auto" MaxWidth="320"/>
                            <DataGridTextColumn Header="Ausgeschieden" Binding="{Binding Ausgeschieden}" Width="Auto" MaxWidth="320"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="#3E3E42"/>
        <Grid Grid.Row="3">
            <RichTextBox x:Name="apLog" Background="#1E1E1E" Foreground="White" FontFamily="Consolas" FontSize="11"
                         IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="6"
                         ToolTip="Rechtsklick: kopieren oder leeren">
                <RichTextBox.Document><FlowDocument/></RichTextBox.Document>
            </RichTextBox>
            <Button x:Name="apBtnLogClear" Content="Leeren" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,22,0"
                    Background="#3E3E42" Style="{StaticResource ToolButton}" Foreground="#CCCCCC" FontSize="11" Padding="8,1" ToolTip="Ausgabe leeren"/>
        </Grid>
    </Grid>
</TabItem>
