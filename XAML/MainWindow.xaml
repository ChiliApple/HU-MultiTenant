                                                    <ComboBoxItem Content="Gruppe" Tag="group"/>
                                                    <ComboBoxItem Content="Alle Geraete" Tag="allDevices"/>
                                                    <ComboBoxItem Content="Keine Zuweisung" Tag="none" ToolTip="Nur hochladen bzw. aktualisieren - zuweisen spaeter hier oder im Portal"/>
                                                </ComboBox>
                                                <TextBox x:Name="txtRemGroup" Style="{StaticResource DarkTextBox}" Width="240" Margin="6,0,0,0" ToolTip="Gruppenname - wird je Tenant gesucht"/>
                                                <Button x:Name="btnRemGroupPick" Content="&#x1F50D;" Style="{StaticResource ToolButton}" FontSize="11" Padding="6,1" Margin="2,0,0,0" ToolTip="Gruppe aus den gewaehlten Tenants suchen und auswaehlen"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Text="Pilot" Style="{StaticResource FieldLabel}"/>
                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                                <CheckBox x:Name="chkRemPilot" Content="zuerst nur an Pilotgruppe:" Style="{StaticResource DarkCheckBox}" VerticalAlignment="Center"/>
                                                <TextBox x:Name="txtRemPilot" Style="{StaticResource DarkTextBox}" Width="200" Margin="6,0,0,0"/>
                                                <Button x:Name="btnRemPilotPick" Content="&#x1F50D;" Style="{StaticResource ToolButton}" FontSize="11" Padding="6,1" Margin="2,0,0,0" ToolTip="Gruppe aus den gewaehlten Tenants suchen und auswaehlen"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="3" Text="Zeitplan" Style="{StaticResource FieldLabel}"/>
                                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                                <ComboBox x:Name="cmbRemSchedule" Style="{StaticResource DarkComboBox}" Width="150">
                                                    <ComboBoxItem Content="Taeglich" Tag="daily"/>
                                                    <ComboBoxItem Content="Stuendlich" Tag="hourly"/>
                                                    <ComboBoxItem Content="Einmal" Tag="once"/>
                                                </ComboBox>
                                                <TextBlock x:Name="lblRemInterval" Text="alle" Style="{StaticResource FieldLabel}" Margin="8,0,4,0"/>
                                                <TextBox x:Name="txtRemInterval" Style="{StaticResource DarkTextBox}" Width="40" Text="1"/>
                                                <TextBlock x:Name="lblRemTime" Text="um" Style="{StaticResource FieldLabel}" Margin="8,0,4,0"/>
                                                <TextBox x:Name="txtRemTime" Style="{StaticResource DarkTextBox}" Width="60" Text="08:00"/>
                                                <TextBox x:Name="txtRemDate" Style="{StaticResource DarkTextBox}" Width="100" Margin="6,0,0,0" ToolTip="Datum TT.MM.JJJJ (nur bei Einmal)"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="4" Text="Ausfuehren als" Style="{StaticResource FieldLabel}"/>
                                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                                <ComboBox x:Name="cmbRemRunAs" Style="{StaticResource DarkComboBox}" Width="150">
                                                    <ComboBoxItem Content="System" Tag="system"/>
                                                    <ComboBoxItem Content="Angemeldeter Benutzer" Tag="user"/>
                                                </ComboBox>
                                                <CheckBox x:Name="chkRem32" Content="32-Bit-PowerShell" Style="{StaticResource DarkCheckBox}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="txtRemTenantState" Style="{StaticResource HintText}" Margin="0,4,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                            </DockPanel>
                            </Grid>

                            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#4CAF50" Opacity="0.4" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>

                            <Border Grid.Row="2" Background="#2D2D2D" CornerRadius="4" Padding="8">
                                <RichTextBox x:Name="rtbRem" Background="#1E1E1E" Foreground="White" FontFamily="Consolas" FontSize="11" IsReadOnly="True"
                                             VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="6">
                                    <RichTextBox.Document><FlowDocument/></RichTextBox.Document>
                                </RichTextBox>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
