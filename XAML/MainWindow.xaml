<!--
    HU-MultiTenant - Hauptfenster.
    Styles: XAML\Theme.xaml (wird beim Laden an der Markierung HU:THEME eingesetzt).
    Alle Elemente mit x:Name stehen im Code als $script:Controls['Name'] zur Verfuegung.
-->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="HU-MultiTenant"
    Width="1180" Height="800" MinWidth="820" MinHeight="520"
    WindowStartupLocation="CenterScreen"
    Background="#1E1E1E"
    UseLayoutRounding="True"
    TextOptions.TextFormattingMode="Display"
    ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!--HU:THEME-->
    </Window.Resources>

    <DockPanel x:Name="rootPanel" Margin="0">

        <!-- ========== TITELLEISTE ========== -->
        <Border DockPanel.Dock="Top" Background="#2D2D2D" Padding="14,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Image x:Name="imgLogo" Width="32" Height="32" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="HU-MultiTenant" FontSize="17" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="txtVersion" FontSize="10" Foreground="#4CAF50"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="txtSecretWarning" Foreground="#FF9800" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="0,0,14,0" Cursor="Hand" Visibility="Collapsed"
                               ToolTip="Klick: Einstellungen &#x2192; Tenants"/>
                    <TextBlock x:Name="txtPermissionStatus" Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11"/>
                    <Button x:Name="btnSetupGuide" Content="&#x1F6E0; Berechtigungen" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                            ToolTip="Benoetigte Graph-Berechtigungen der gewaehlten Extension pruefen und einrichten"/>
                    <Button x:Name="btnSettings" Content="&#x2699; Einstellungen" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                            ToolTip="Tenants, Secrets, Verknuepfungen, Darstellung, Update"/>
                    <Button x:Name="btnSupport" Content="&#x1F6DF; Support" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                            ToolTip="Protokolle anonymisiert als ZIP packen und per E-Mail oder GitHub-Issue Hilfe anfragen"/>
                    <Button x:Name="btnHelp" Content="?" Style="{StaticResource ToolButton}" Width="32" Margin="0,0,6,0"
                            ToolTip="Anleitung (F1)"/>
                    <Button x:Name="btnUpdate" Content="Update" Style="{StaticResource ToolButton}"
                            ToolTip="Update von GitHub (Rechtsklick: weitere Optionen)"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========== TENANT-AUSWAHL ========== -->
        <Border DockPanel.Dock="Top" Background="#252526" Padding="14,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Tenant:" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="cmbTenant" Width="300" FontSize="12"/>
                    <TextBlock x:Name="txtTenantStatus" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12"/>
                    <TextBlock x:Name="txtSecretExpiry" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11" Foreground="#858585"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="chkPersistCred" Content="Secret speichern"
                              Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,12,0"
                              FontSize="11" IsChecked="True" IsEnabled="False"
                              ToolTip="Aus: Secret wird beim Beenden geloescht"/>
                    <Button x:Name="btnValidate" Content="Verbinden" Background="#1976D2" Style="{StaticResource DarkButton}" Margin="0,0,6,0"/>
                    <Button x:Name="btnDisconnect" Content="Trennen" Background="#D32F2F" Style="{StaticResource DarkButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========== HAUPTBEREICH (links Extensions, rechts Reiter) ========== -->
        <Grid x:Name="gridMain" Margin="10,8,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="colLeft" Width="320" MinWidth="200"/>
                <ColumnDefinition x:Name="colSplit" Width="8"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- LINKS: EXTENSIONS -->
            <Border Grid.Column="0" x:Name="pnlLeft" Background="#2D2D2D" CornerRadius="4" Padding="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock x:Name="btnReloadExt" DockPanel.Dock="Right" Text="&#x21BB;" Foreground="#858585"
                                   FontSize="15" Cursor="Hand" VerticalAlignment="Center" Margin="6,0,0,0"
                                   ToolTip="Extensions neu laden"/>
                        <TextBlock Text="Extensions" FontWeight="Bold" Foreground="White" FontSize="13"/>
                    </DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBox x:Name="txtExtSearch" Style="{StaticResource DarkTextBox}" FontSize="11"/>
                        <TextBlock Text="Suchen ..." Foreground="#666666" FontSize="11" Margin="9,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" x:Name="txtExtSearchHint"/>
                    </Grid>
                    <ListBox x:Name="lstExtensions" Background="#1E1E1E" Foreground="White" BorderThickness="0"
                             FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,5" BorderThickness="0,0,0,1" BorderBrush="#3E3E42">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Category}" FontSize="9" Foreground="#1976D2"
                                                       FontWeight="Bold" DockPanel.Dock="Left" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#4CAF50"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Synopsis}" FontSize="9" Foreground="#858585"
                                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="DRY-RUN" FontSize="8" Foreground="#FF9800" Margin="0,0,8,0"
                                                       Visibility="{Binding DryRunVisible}"/>
                                            <TextBlock Text="BATCH" FontSize="8" Foreground="#2196F3" Margin="0,0,8,0"
                                                       Visibility="{Binding BatchVisible}"/>
                                            <TextBlock Text="SCHREIBT" FontSize="8" Foreground="#E6820E"
                                                       Visibility="{Binding WriteVisible}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" x:Name="splLeft" Width="4" Background="#3E3E42" Opacity="0.5" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>

            <!-- RECHTS: Reiter Quick Script | Extensions | Apps | Wartung -->
            <TabControl Grid.Column="2" x:Name="tabMain" Style="{StaticResource DarkTabControl}" Background="#1E1E1E">

                <!-- ===== REITER: QUICK SCRIPT ===== -->
                <TabItem Header="&#x26A1; Quick Script" x:Name="tabQuickScript" Style="{StaticResource DarkTabItem}">
                    <Grid x:Name="gridQS" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="rowQSEditor" Height="2*" MinHeight="80"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition x:Name="rowQSOutput" Height="*" MinHeight="60"/>
                        </Grid.RowDefinitions>

                        <!-- Zeile 0: Tenant -->
                        <Border Grid.Row="0" Background="#2D2D2D" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                            <DockPanel>
                                <TextBlock Text="Tenant:" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="cmbQSTenant" Width="240" FontSize="11" Style="{StaticResource DarkComboBox}" Margin="0,0,4,0"/>
                                <Button x:Name="btnQSMulti" Content="Mehrere &#x25BE;" Style="{StaticResource ToolButton}" FontSize="11" Padding="8,3" Margin="0,0,8,0"
                                        ToolTip="Dasselbe Skript nacheinander auf mehreren Tenants ausfuehren"/>
                                <Popup x:Name="popQSTenants" PlacementTarget="{Binding ElementName=btnQSMulti}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                    <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="10" MinWidth="260">
                                        <StackPanel>
                                            <TextBlock Text="Auf mehreren Tenants ausf&#xFC;hren" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                            <StackPanel x:Name="spQSTenants"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button x:Name="btnQSAll" Content="Alle" Style="{StaticResource ToolButton}" FontSize="11" Padding="8,2" Margin="0,0,4,0"/>
                                                <Button x:Name="btnQSNone" Content="Keine (nur Auswahl links)" Style="{StaticResource ToolButton}" FontSize="11" Padding="8,2"/>
                                            </StackPanel>
                                            <TextBlock Text="Ab 2 Haken l&#xE4;uft das Skript je Tenant einmal ($Token, $TenantKey wechseln). Objekt-Ausgaben bekommen die Spalte Tenant."
                                                       Style="{StaticResource HintText}" Margin="0,8,0,0" MaxWidth="300"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                                <Button x:Name="btnQSConnect" Content="&#x26A1; Verbinden" Background="#1976D2"
                                        Style="{StaticResource DarkButton}" Margin="0,0,4,0"/>
                                <Button x:Name="btnQSDisconnect" Content="&#x2715; Trennen" Background="#C62828"
                                        Style="{StaticResource DarkButton}" IsEnabled="False" Margin="0,0,10,0"/>
                                <TextBlock x:Name="txtQSSecret" DockPanel.Dock="Right" Foreground="#858585" FontSize="10"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"/>
                                <TextBlock x:Name="txtQSMulti" Foreground="#4FC3F7" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="txtQSStatus" Foreground="#858585" FontSize="11" VerticalAlignment="Center" Text="Nicht verbunden"/>
                            </DockPanel>
                        </Border>

                        <!-- Zeile 1: Snippets -->
                        <Border Grid.Row="1" Background="#252526" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="Snippet:" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button x:Name="btnSnippetManage" DockPanel.Dock="Right" Content="&#x1F4DA; Verwalten ..." Background="#5C6BC0"
                                            Style="{StaticResource DarkButton}" FontSize="11" Margin="6,0,0,0"
                                            ToolTip="Alle Snippets mit Beschreibung: suchen, umbenennen, sortieren, loeschen, importieren, exportieren"/>
                                    <Button x:Name="btnSnippetSaveAs" DockPanel.Dock="Right" Content="Speichern unter ..." Background="#3E3E42"
                                            Style="{StaticResource DarkButton}" FontSize="11" Margin="6,0,0,0"
                                            ToolTip="Als neues Snippet speichern (Name und Beschreibung)"/>
                                    <Button x:Name="btnSnippetSave" DockPanel.Dock="Right" Content="&#x1F4BE; Speichern" Background="#388E3C"
                                            Style="{StaticResource DarkButton}" FontSize="11" Margin="6,0,0,0"
                                            ToolTip="Aktuelles Snippet speichern (Strg+S)"/>
                                    <Button x:Name="btnSnippetNew" DockPanel.Dock="Right" Content="Neu" Background="#3E3E42"
                                            Style="{StaticResource DarkButton}" FontSize="11" Margin="6,0,0,0"
                                            ToolTip="Leeren Editor beginnen (Strg+N)"/>
                                    <ComboBox x:Name="cmbSnippets" FontSize="11" Style="{StaticResource DarkComboBox}" MaxDropDownHeight="520"
                                              ToolTip="Snippet waehlen - wird sofort in den Editor geladen">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Star}" Foreground="#FFC107" Width="14"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="#E0E0E0"/>
                                                    <TextBlock Text="{Binding CatShort}" Foreground="#9E9E9E" FontSize="10" Margin="8,1,0,0"/>
                                                    <TextBlock Text="{Binding DescShort}" Foreground="#858585" Margin="10,0,0,0" FontStyle="Italic"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel Margin="0,5,0,0">
                                    <TextBlock x:Name="btnSnippetFav" Text="&#x2606;" Foreground="#666666" FontSize="15" Cursor="Hand" Margin="0,-2,6,0"
                                               ToolTip="Favorit an/aus - Favoriten stehen in der Auswahl oben"/>
                                    <TextBlock x:Name="txtSnippetDirty" Text="" Foreground="#FF9800" FontSize="11" FontWeight="Bold" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="txtSnippetName" Foreground="#E0E0E0" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                    <Border x:Name="bdSnippetCat" Background="#3E3E42" CornerRadius="3" Padding="5,0" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock x:Name="txtSnippetCat" Foreground="#BDBDBD" FontSize="10"/>
                                    </Border>
                                    <TextBlock x:Name="txtSnippetDesc" Foreground="#858585" FontSize="11" FontStyle="Italic" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <WrapPanel x:Name="pnlQSParams" Margin="0,6,0,0" Visibility="Collapsed"
                                           ToolTip="Parameter aus den Kopfzeilen '# @param ...' des Snippets"/>
                            </StackPanel>
                        </Border>

                        <!-- Zeile 2: Ausfuehren -->
                        <DockPanel Grid.Row="2" Margin="0,0,0,4">
                            <Button x:Name="btnQSRun" Content="&#x25B6; Ausf&#xFC;hren" Background="#4CAF50"
                                    Style="{StaticResource DarkButton}" FontSize="13" IsEnabled="False" DockPanel.Dock="Left" Margin="0,0,6,0"
                                    ToolTip="Strg+Enter / F5 = alles ausfuehren, F8 = nur Markierung"/>
                            <Button x:Name="btnQSStop" Content="&#x25A0; Abbrechen" Background="#D32F2F"
                                    Style="{StaticResource DarkButton}" FontSize="12" IsEnabled="False" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                            <Button x:Name="btnQSHistory" Content="&#x1F552; Verlauf" Background="#3E3E42"
                                    Style="{StaticResource DarkButton}" FontSize="11" DockPanel.Dock="Right" Margin="6,0,0,0"
                                    ToolTip="Fruehere Laeufe mit Protokoll"/>
                            <Button x:Name="btnQSTable" Content="&#x1F4CA; Tabelle" Background="#1976D2"
                                    Style="{StaticResource DarkButton}" FontSize="11" DockPanel.Dock="Right" Margin="6,0,0,0" IsEnabled="False"
                                    ToolTip="Objekt-Ausgaben des letzten Laufs als Tabelle - filtern, CSV/Excel"/>
                            <Button x:Name="btnQSClear" Content="Ausgabe leeren" Background="#3E3E42"
                                    Style="{StaticResource DarkButton}" FontSize="11" DockPanel.Dock="Right"/>
                            <Button x:Name="btnQSCopy" Content="Ausgabe kopieren" Background="#3E3E42"
                                    Style="{StaticResource DarkButton}" FontSize="11" DockPanel.Dock="Right" Margin="0,0,6,0"/>
                            <TextBlock Text="Strg+Enter / F5 ausf&#xFC;hren &#xB7; F8 Markierung &#xB7; Strg+S speichern &#xB7; Strg+Mausrad Schrift"
                                       Foreground="#666666" FontSize="10" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Zeile 3: Editor -->
                        <Border Grid.Row="3" Background="#2D2D2D" CornerRadius="4" Padding="2" Margin="0,0,0,2">
                            <TextBox x:Name="txtQSEditor"
                                     Background="#1E1E1E" Foreground="#D4D4D4" CaretBrush="#D4D4D4" SelectionBrush="#264F78"
                                     FontFamily="Consolas" FontSize="12"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     BorderThickness="0" Padding="8" TextWrapping="NoWrap"/>
                        </Border>

                        <GridSplitter Grid.Row="4" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                      Background="#4CAF50" Opacity="0.4" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                      Cursor="SizeNS" Margin="0,1"/>

                        <!-- Zeile 5: Ausgabe -->
                        <Border Grid.Row="5" Background="#2D2D2D" CornerRadius="4" Padding="10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Ausgabe" FontWeight="Bold" Foreground="White" FontSize="12" Margin="0,0,0,6"/>
                                <RichTextBox x:Name="rtbQSOutput" Background="#1E1E1E" Foreground="White"
                                             FontFamily="Consolas" FontSize="11" IsReadOnly="True"
                                             VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="6">
                                    <RichTextBox.Document>
                                        <FlowDocument/>
                                    </RichTextBox.Document>
                                </RichTextBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ===== REITER: EXTENSIONS ===== -->
                <TabItem Header="&#x1F9E9; Extensions" x:Name="tabExtensions" Style="{StaticResource DarkTabItem}">
                    <Grid x:Name="gridExt" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="rowExtDetails" Height="1.2*" MinHeight="140"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition x:Name="rowExtLog" Height="*" MinHeight="80"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <!-- Start / Abbrechen -->
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,0,0,4">
                                <TextBlock x:Name="txtDryRunBanner" Text="" Foreground="#FF9800" FontWeight="Bold" VerticalAlignment="Center" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="btnStart" Content="&#x25B6; STARTEN" Background="#4CAF50"
                                            Style="{StaticResource DarkButton}" FontSize="13" Margin="0,0,8,0" IsEnabled="False"/>
                                    <Button x:Name="btnCancel" Content="&#x2297; ABBRECHEN" Background="#D32F2F"
                                            Style="{StaticResource DarkButton}" FontSize="13" IsEnabled="False"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Extension-Details -->
                            <Border Background="#2D2D2D" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock x:Name="txtExtTitle" FontWeight="Bold" FontSize="14" Foreground="White" Text="Extension links auswaehlen"/>
                                            <TextBlock x:Name="txtExtRuntime" Text="" FontSize="9" FontWeight="Bold" Foreground="#1E1E1E"
                                                       Background="#4CAF50" Padding="4,1" Margin="8,2,0,0" VerticalAlignment="Center"
                                                       HorizontalAlignment="Left" Visibility="Collapsed"/>
                                            <TextBlock x:Name="txtExtMode" Text="" FontSize="9" FontWeight="Bold" Foreground="White"
                                                       Background="#E6820E" Padding="4,1" Margin="4,2,0,0" VerticalAlignment="Center"
                                                       HorizontalAlignment="Left" Visibility="Collapsed"/>
                                        </DockPanel>
                                        <TextBlock x:Name="txtExtSynopsis" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11"/>
                                        <TextBlock x:Name="txtExtDescription" Foreground="#AAAAAA" TextWrapping="Wrap"
                                                   Margin="0,6,0,0" FontSize="11" Visibility="Collapsed"/>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="190"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Benoetigte Berechtigungen:" FontSize="10" FontWeight="Bold" Foreground="#FFEB3B" Margin="0,0,0,4"/>
                                                <ListBox x:Name="lstPermissions" MaxHeight="80" Background="#1E1E1E" Foreground="#CCCCCC"
                                                         BorderBrush="#3E3E42" FontSize="10" FontFamily="Consolas"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <CheckBox x:Name="chkDryRun" Content="DRY-RUN (nur Vorschau)" Foreground="#FF9800"
                                                          Style="{StaticResource DarkCheckBox}" IsEnabled="False"/>
                                                <CheckBox x:Name="chkLogging" Content="Ausgabe protokollieren" IsChecked="True"
                                                          Style="{StaticResource DarkCheckBox}"/>
                                                <CheckBox x:Name="chkKeepConnected" Content="Verbunden bleiben" IsChecked="True"
                                                          Style="{StaticResource DarkCheckBox}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border x:Name="pnlCustomParams" Background="#252526" CornerRadius="4" Padding="8" Margin="0,8,0,0" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="Parameter:" FontSize="10" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,6"/>
                                                <StackPanel x:Name="spCustomParams"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                        </DockPanel>

                        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                      Background="#4CAF50" Opacity="0.4" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                      Cursor="SizeNS" Margin="0,1"/>

                        <!-- Protokoll -->
                        <Border Grid.Row="2" Background="#2D2D2D" CornerRadius="4" Padding="10">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Button x:Name="btnClearLog" Content="Leeren" Background="#3E3E42"
                                            Style="{StaticResource DarkButton}" DockPanel.Dock="Right" FontSize="11" Padding="14,4"/>
                                    <Button x:Name="btnOpenLogFolder" Content="Log-Ordner" Background="#3E3E42"
                                            Style="{StaticResource DarkButton}" DockPanel.Dock="Right" FontSize="11" Padding="14,4" Margin="0,0,6,0"/>
                                    <Button x:Name="btnOpenReports" Content="Reports" Background="#3E3E42"
                                            Style="{StaticResource DarkButton}" DockPanel.Dock="Right" FontSize="11" Padding="14,4" Margin="0,0,6,0"/>
                                    <TextBlock Text="Protokoll" FontWeight="Bold" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                </DockPanel>
                                <RichTextBox x:Name="rtbLog" Background="#1E1E1E" Foreground="White"
                                             FontFamily="Consolas" FontSize="11" IsReadOnly="True"
                                             VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="6">
                                    <RichTextBox.Document>
                                        <FlowDocument/>
                                    </RichTextBox.Document>
                                </RichTextBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ===== REITER: APPS ===== -->
                <TabItem Header="&#x1F4E6; Apps" x:Name="tabApps" Style="{StaticResource DarkTabItem}">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="colAppsLeft" Width="250" MinWidth="180"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Bibliothek | In Intune -->
                        <Border Grid.Column="0" Background="#252526" CornerRadius="4" Padding="8">
                            <DockPanel>
                            <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="0,0,0,8">
                                <Button x:Name="btnAppModeLib" Content="Bibliothek" Style="{StaticResource ToolButton}" FontSize="11" Padding="6,3" Margin="0,0,2,0"
                                        ToolTip="Eigene Apps: Setup-Dateien und Store-Apps, die HU-MultiTenant paketiert und hochlaedt"/>
                                <Button x:Name="btnAppModeInt" Content="In Intune" Style="{StaticResource ToolButton}" FontSize="11" Padding="6,3" Margin="2,0,0,0"
                                        ToolTip="Alle Windows-Apps, die schon in Intune liegen: Zuweisungen, Eigenschaften, Abhaengigkeiten, Status, Loeschen"/>
                            </UniformGrid>
                            <Grid>
                            <DockPanel x:Name="pnlAppLibLeft">
                                <TextBlock DockPanel.Dock="Top" Text="App-Bibliothek" Style="{StaticResource SectionTitle}"/>
                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Button x:Name="btnAppAdd" Content="+ MSI / EXE ..." Style="{StaticResource ToolButton}" FontSize="11" Padding="8,3" Margin="0,0,4,4"
                                            ToolTip="Setup-Datei waehlen - Name, Version, Befehle und Erkennung werden ausgelesen"/>
                                    <Button x:Name="btnAppAddStore" Content="+ Store-App" Style="{StaticResource ToolButton}" FontSize="11" Padding="8,3" Margin="0,0,4,4"
                                            ToolTip="Microsoft Store App (neu) - nur die Store-ID, kein Paket"/>
                                    <Button x:Name="btnAppRemove" Content="Entfernen" Style="{StaticResource ToolButton}" FontSize="11" Padding="8,3" Margin="0,0,4,4"
                                            ToolTip="Nur aus der Bibliothek entfernen - in Intune bleibt die App bestehen"/>
                                </WrapPanel>
                                <TextBlock DockPanel.Dock="Bottom" Text="Setup-Datei auch per Ziehen &amp; Ablegen auf die Liste." Style="{StaticResource HintText}" Margin="0,6,0,0"/>
                                <ListBox x:Name="lstApps" Style="{StaticResource DarkListBox}" AllowDrop="True">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding Title}" Foreground="#E0E0E0" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Sub}" Foreground="#858585" FontSize="10"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            <DockPanel x:Name="pnlAppIntLeft" Visibility="Collapsed">
                                <TextBlock DockPanel.Dock="Top" Text="Apps in Intune" Style="{StaticResource SectionTitle}"/>
                                <WrapPanel DockPanel.Dock="Top" x:Name="spIntTenants" Margin="0,0,0,4"/>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <Button x:Name="btnIntLoad" DockPanel.Dock="Right" Content="&#x21BB;" Style="{StaticResource ToolButton}" FontSize="12" Padding="8,1" Margin="4,0,0,0" ToolTip="Neu laden"/>
                                    <ComboBox x:Name="cmbIntType" DockPanel.Dock="Right" Style="{StaticResource DarkComboBox}" Width="86" Margin="4,0,0,0">
                                        <ComboBoxItem Content="Alle" Tag="" IsSelected="True"/>
                                        <ComboBoxItem Content="Win32" Tag="win32"/>
                                        <ComboBoxItem Content="Store" Tag="winget"/>
                                        <ComboBoxItem Content="Sonstige" Tag="other"/>
                                    </ComboBox>
                                    <Grid>
                                        <TextBox x:Name="txtIntFilter" Style="{StaticResource DarkTextBox}"/>
                                        <TextBlock x:Name="lblIntFilterHint" Text="Filtern ..." Foreground="#666666" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    </Grid>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" x:Name="lblIntState" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <ListBox x:Name="lstIntApps" Style="{StaticResource DarkListBox}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding Title}" Foreground="#E0E0E0" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Sub}" Foreground="#858585" FontSize="10"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                            </Grid>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="6" Background="#3E3E42" Opacity="0.4" HorizontalAlignment="Center" ResizeBehavior="PreviousAndNext"/>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="rowAppsForm" Height="2*" MinHeight="200"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition x:Name="rowAppsLog" Height="*" MinHeight="60"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                            <DockPanel x:Name="pnlAppLibRight">
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <Button x:Name="btnAppSave" Content="&#x1F4BE; Speichern" Background="#388E3C" Style="{StaticResource DarkButton}" FontSize="11" Margin="0,0,6,4"/>
                                <Button x:Name="btnAppDeploy" Content="&#x2B06; Hochladen &amp; zuweisen" Background="#1976D2" Style="{StaticResource DarkButton}" FontSize="12" Margin="0,0,6,4"
                                        ToolTip="Paket bauen (einmal), in jeden gewaehlten Tenant hochladen bzw. aktualisieren und zuweisen"/>
                                <Button x:Name="btnAppRelease" Content="Fuer alle freigeben" Background="#5C6BC0" Style="{StaticResource DarkButton}" FontSize="11" Margin="0,0,6,4"
                                        ToolTip="Nach dem Pilot: Zuweisung an das eigentliche Ziel ergaenzen"/>
                                <Button x:Name="btnAppStatus" Content="&#x1F4CA; Status" Background="#3E3E42" Style="{StaticResource DarkButton}" FontSize="11" Margin="0,0,6,4"
                                        ToolTip="Installationsstatus je Geraet (Intune-Bericht, kann 1-2 Minuten dauern)"/>
                                <Button x:Name="btnAppPackages" Content="Paket-Ordner" Background="#3E3E42" Style="{StaticResource DarkButton}" FontSize="11" Margin="0,0,6,4"/>
                            </WrapPanel>
                            <Border Background="#2D2D2D" CornerRadius="4" Padding="12">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="pnlAppForm" IsEnabled="False">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Name" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtAppName" Style="{StaticResource DarkTextBox}" Margin="0,2"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="txtAppKind" Foreground="#4FC3F7" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            <TextBlock Grid.Row="1" Text="Hersteller" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtAppPublisher" Style="{StaticResource DarkTextBox}" Margin="0,2"/>
                                            <TextBlock Grid.Row="2" Text="Version" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtAppVersion" Style="{StaticResource DarkTextBox}" Margin="0,2" Width="160" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Row="3" Text="Beschreibung" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtAppDesc" Style="{StaticResource DarkTextBox}" Margin="0,2"/>
                                            <StackPanel Grid.Row="1" Grid.RowSpan="3" Grid.Column="2" Orientation="Horizontal" Margin="10,2,0,2" VerticalAlignment="Top">
                                                <Border Width="72" Height="72" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4"
                                                        ToolTip="Symbol im Unternehmensportal">
                                                    <Grid>
                                                        <TextBlock x:Name="lblAppIconNone" Text="kein&#x0a;Symbol" Foreground="#666666" FontSize="10" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image x:Name="imgAppIcon" Width="64" Height="64" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <Button x:Name="btnAppIcon" Content="Symbol ..." Style="{StaticResource ToolButton}" FontSize="11" Padding="8,2" Margin="0,0,0,4"
                                                            ToolTip="Bild (PNG, JPG), ICO oder EXE waehlen - wird als PNG (max. 256 px) im Unternehmensportal angezeigt"/>
                                                    <Button x:Name="btnAppIconClear" Content="Entfernen" Style="{StaticResource ToolButton}" FontSize="11" Padding="8,2"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Win32 (MSI/EXE) -->
                                        <StackPanel x:Name="pnlAppWin32" Margin="0,8,0,0">
                                            <TextBlock Text="Installation" Style="{StaticResource SectionTitle}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="Setup-Datei" Style="{StaticResource FieldLabel}"/>
                                                <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,2">
                                                    <Button x:Name="btnAppBrowse" DockPanel.Dock="Right" Content="Andere Datei ..." Style="{StaticResource ToolButton}" FontSize="11" Padding="8,2" Margin="6,0,0,0"/>
                                                    <TextBox x:Name="txtAppSetup" Style="{StaticResource DarkTextBox}" IsReadOnly="True"/>
                                                </DockPanel>
                                                <WrapPanel Grid.Row="1" Grid.Column="1">
                                                    <CheckBox x:Name="chkAppWholeFolder" Content="Ganzen Ordner mitpacken" Style="{StaticResource DarkCheckBox}" Margin="0,2,16,2"
                                                              ToolTip="Bei Setups mit Zusatzdateien (Transform .mst, Konfiguration, CAB)"/>
                                                    <CheckBox x:Name="chkAppNoDesktop" Content="Ohne Desktop-Verknuepfung" Style="{StaticResource DarkCheckBox}" Margin="0,2"
                                                              ToolTip="Neue Verknuepfungen auf dem Desktop werden nach der Installation entfernt (HU-Install.ps1 im Paket) - klappt bei jedem Setup"/>
                                                </WrapPanel>
                                                <TextBlock Grid.Row="2" Text="Installieren" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtAppInstall" Style="{StaticResource DarkTextBox}" FontFamily="Consolas" Margin="0,2"/>
                                                <TextBlock Grid.Row="3" Text="Deinstallieren" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtAppUninstall" Style="{StaticResource DarkTextBox}" FontFamily="Consolas" Margin="0,2"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtAppInfo" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                            </Grid>

                                            <TextBlock Text="Erkennung (woran Intune sieht, dass die App installiert ist)" Style="{StaticResource SectionTitle}" Margin="0,10,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="Art" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cmbAppDetType" Style="{StaticResource DarkComboBox}" Width="260" HorizontalAlignment="Left" Margin="0,2">
                                                    <ComboBoxItem Content="MSI-Produktcode" Tag="msi"/>
                                                    <ComboBoxItem Content="Registry-Eintrag" Tag="registry"/>
                                                    <ComboBoxItem Content="Datei oder Ordner" Tag="file"/>
                                                    <ComboBoxItem Content="Skript" Tag="script"/>
                                                </ComboBox>
                                                <TextBlock Grid.Row="1" x:Name="lblAppDetA" Text="Produktcode" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtAppDetA" Style="{StaticResource DarkTextBox}" FontFamily="Consolas" Margin="0,2"/>
                                                <TextBlock Grid.Row="2" x:Name="lblAppDetB" Text="Wert" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtAppDetB" Style="{StaticResource DarkTextBox}" FontFamily="Consolas" Margin="0,2"/>
                                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                                    <CheckBox x:Name="chkAppDetVer" Content="Version mindestens" Style="{StaticResource DarkCheckBox}" VerticalAlignment="Center"/>
                                                    <TextBox x:Name="txtAppDetVer" Style="{StaticResource DarkTextBox}" Width="120" Margin="6,0,16,0"/>
                                                    <CheckBox x:Name="chkAppDet32" Content="32-Bit-Bereich (WOW6432Node / Program Files (x86))" Style="{StaticResource DarkCheckBox}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtAppDetScript" Style="{StaticResource DarkTextBox}" FontFamily="Consolas"
                                                         AcceptsReturn="True" AcceptsTab="True" Height="110" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,2" Visibility="Collapsed"/>
                                            </Grid>
                                            <Border Background="#252526" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                                                <StackPanel>
                                                    <WrapPanel>
                                                        <Button x:Name="btnAppSandbox" Content="&#x1F9EA; Testinstallation in der Windows Sandbox" Background="#6A1B9A" Style="{StaticResource DarkButton}" FontSize="11" Margin="0,0,10,0"
                                                                ToolTip="Installiert in einer Wegwerf-Sandbox und ermittelt Erkennung und Deinstallation - dein PC bleibt sauber"/>
                                                        <CheckBox x:Name="chkAppSandboxUninstall" Content="Deinstallation mittesten" IsChecked="True" Style="{StaticResource DarkCheckBox}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <CheckBox x:Name="chkAppSandboxKeep" Content="Sandbox offen lassen" Style="{StaticResource DarkCheckBox}" VerticalAlignment="Center"/>
                                                    </WrapPanel>
                                                    <TextBlock x:Name="txtAppSandbox" Style="{StaticResource HintText}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <TextBlock Text="Abhaengigkeiten" Style="{StaticResource FieldLabel}" ToolTip="Werden vor der App installiert - z. B. Treiber, Laufzeitumgebungen"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock x:Name="lblAppDeps" Text="keine" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <Button x:Name="btnAppDepAdd" Content="+ Bibliothek ..." Style="{StaticResource ToolButton}" FontSize="11" Padding="6,1" Margin="0,0,4,0"
                                                            ToolTip="App aus der Bibliothek - wird beim Hochladen mit hochgeladen (nur Setup-Dateien, keine Store-Apps)"/>
                                                    <Button x:Name="btnAppDepAddIntune" Content="+ Intune ..." Style="{StaticResource ToolButton}" FontSize="11" Padding="6,1" Margin="0,0,4,0"
                                                            ToolTip="Win32-App, die schon in Intune liegt (z. B. Treiber, Runtime) - wird nur verknuepft, je Tenant per Name gesucht"/>
                                                    <Button x:Name="btnAppDepRemove" Content="Entfernen" Style="{StaticResource ToolButton}" FontSize="11" Padding="6,1" Visibility="Collapsed"/>
                                                </StackPanel>
                                                <ListBox Grid.Row="1" Grid.Column="1" x:Name="lstAppDeps" Style="{StaticResource DarkListBox}" MaxHeight="110" SelectionMode="Extended" Margin="0,2" Visibility="Collapsed">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                                <TextBlock Text="{Binding Title}" Foreground="#E0E0E0"/>
                                                                <TextBlock Text="{Binding Sub}" Foreground="#858585" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <CheckBox Grid.Row="2" Grid.Column="1" x:Name="chkAppDepAuto" IsChecked="True" Style="{StaticResource DarkCheckBox}" Margin="0,2,0,0" Visibility="Collapsed"
                                                          Content="automatisch mitinstallieren (brauchen keine eigene Zuweisung)"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Store -->
                                        <StackPanel x:Name="pnlAppStore" Margin="0,8,0,0" Visibility="Collapsed">
                                            <TextBlock Text="Microsoft Store App (neu)" Style="{StaticResource SectionTitle}"/>
                                            <DockPanel>
                                                <TextBlock Text="Store-ID" Style="{StaticResource FieldLabel}" Width="122"/>
                                                <Button x:Name="btnAppStoreOpen" DockPanel.Dock="Right" Content="apps.microsoft.com" Style="{StaticResource ToolButton}" FontSize="11" Padding="8,2" Margin="6,0,0,0"
                                                        ToolTip="App im Browser suchen - die ID steht in der Adresse (z. B. 9NKSQGP7F2NH)"/>
                                                <TextBox x:Name="txtAppStoreId" Style="{StaticResource DarkTextBox}" FontFamily="Consolas" Width="200" HorizontalAlignment="Left"/>
                                            </DockPanel>
                                            <TextBlock Text="Store-Apps aktualisieren sich selbst; Intune braucht kein Paket. Nur Apps aus dem Microsoft Store (keine Win32-Store-Apps mit Lizenzpflicht)." Style="{StaticResource HintText}" Margin="130,4,0,0"/>
                                        </StackPanel>

                                        <DockPanel Margin="0,8,0,0">
                                            <TextBlock Text="Ausfuehren als" Style="{StaticResource FieldLabel}" Width="122"/>
                                            <ComboBox x:Name="cmbAppRunAs" Style="{StaticResource DarkComboBox}" Width="160" HorizontalAlignment="Left">
                                                <ComboBoxItem Content="System (fuer alle)" Tag="system"/>
                                                <ComboBoxItem Content="Benutzer" Tag="user"/>
                                            </ComboBox>
                                        </DockPanel>

                                        <!-- Verteilen -->
                                        <TextBlock Text="Verteilen" Style="{StaticResource SectionTitle}" Margin="0,12,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Tenants" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,4,8,0"/>
                                            <WrapPanel Grid.Row="0" Grid.Column="1" x:Name="spAppTenants" Margin="0,2"/>
                                            <TextBlock Grid.Row="1" Text="Ziel" Style="{StaticResource FieldLabel}"/>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                                <ComboBox x:Name="cmbAppTarget" Style="{StaticResource DarkComboBox}" Width="150">
                                                    <ComboBoxItem Content="Gruppe" Tag="group"/>
                                                    <ComboBoxItem Content="Alle Geraete" Tag="allDevices"/>
                                                    <ComboBoxItem Content="Alle Benutzer" Tag="allUsers"/>
                                                    <ComboBoxItem Content="Keine Zuweisung" Tag="none" ToolTip="Nur hochladen bzw. aktualisieren - z. B. als Abhaengigkeit oder zum spaeteren Zuweisen im Portal"/>
                                                </ComboBox>
                                                <TextBox x:Name="txtAppGroup" Style="{StaticResource DarkTextBox}" Width="240" Margin="6,0,0,0" ToolTip="Gruppenname - wird je Tenant gesucht"/>
                                                <Button x:Name="btnAppGroupPick" Content="&#x1F50D;" Style="{StaticResource ToolButton}" FontSize="11" Padding="6,1" Margin="2,0,0,0" ToolTip="Gruppe aus den gewaehlten Tenants suchen und auswaehlen"/>
                                                <ComboBox x:Name="cmbAppIntent" Style="{StaticResource DarkComboBox}" Width="200" Margin="6,0,0,0">
                                                    <ComboBoxItem Content="Erforderlich (installieren)" Tag="required"/>
                                                    <ComboBoxItem Content="Verfuegbar (Unternehmensportal)" Tag="available"/>
                                                    <ComboBoxItem Content="Deinstallieren" Tag="uninstall"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Text="Pilot" Style="{StaticResource FieldLabel}"/>
                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                                <CheckBox x:Name="chkAppPilot" Content="zuerst nur an Pilotgruppe:" Style="{StaticResource DarkCheckBox}" VerticalAlignment="Center"/>
                                                <TextBox x:Name="txtAppPilot" Style="{StaticResource DarkTextBox}" Width="200" Margin="6,0,0,0"/>
                                                <Button x:Name="btnAppPilotPick" Content="&#x1F50D;" Style="{StaticResource ToolButton}" FontSize="11" Padding="6,1" Margin="2,0,0,0" ToolTip="Gruppe aus den gewaehlten Tenants suchen und auswaehlen"/>
                                                <TextBlock Text="(spaeter &quot;Fuer alle freigeben&quot;)" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="3" Text="Frist / Hinweise" Style="{StaticResource FieldLabel}"/>
                                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                                <TextBox x:Name="txtAppDeadline" Style="{StaticResource DarkTextBox}" Width="110" ToolTip="Optional (nur bei Erforderlich): TT.MM.JJJJ oder TT.MM.JJJJ HH:mm - bis dahin muss installiert sein (ohne Uhrzeit 16:00)"/>
                                                <ComboBox x:Name="cmbAppNotify" Style="{StaticResource DarkComboBox}" Width="200" Margin="6,0,0,0">
                                                    <ComboBoxItem Content="Hinweise anzeigen" Tag="showAll"/>
                                                    <ComboBoxItem Content="Nur Neustart-Hinweise" Tag="showReboot"/>
                                                    <ComboBoxItem Content="Keine Hinweise" Tag="hideAll"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtAppTenantState" Style="{StaticResource HintText}" Margin="0,4,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                            </DockPanel>
                            <DockPanel x:Name="pnlAppIntRight" Visibility="Collapsed">
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <Button x:Name="btnIntStatus" Content="&#x1F4CA; Status" Background="#3E3E42" Style="{StaticResource DarkButton}" FontSize="11" Margin="0,0,6,4"
                                        ToolTip="Installationsstatus je Geraet (Intune-Bericht, kann 1-2 Minuten dauern)"/>
                                <Button x:Name="btnIntReloadOne" Content="&#x21BB; Neu laden" Background="#3E3E42" Style="{StaticResource DarkButton}" FontSize="11" Margin="0,0,6,4"/>
                                <Button x:Name="btnIntPortal" Content="Im Portal oeffnen" Background="#3E3E42" Style="{StaticResource DarkButton}" FontSize="11" Margin="0,0,6,4"/>
                                <Button x:Name="btnIntDelete" Content="&#x1F5D1; Loeschen ..." Background="#B71C1C" Style="{StaticResource DarkButton}" FontSize="11" Margin="12,0,6,4"
                                        ToolTip="App in den gewaehlten Tenants aus Intune loeschen (mit Rueckfrage)"/>
                            </WrapPanel>
                            <Border Background="#2D2D2D" CornerRadius="4" Padding="12">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="pnlIntForm" IsEnabled="False">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="56" Height="56" Background="#252526" CornerRadius="4" Margin="0,0,12,0">
                                                <Image x:Name="imgIntIcon" Width="48" Height="48" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="txtIntTitle" Text="Links eine App waehlen" Foreground="#E0E0E0" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="txtIntInfo" Style="{StaticResource HintText}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <TextBlock Text="Zuweisungen" Style="{StaticResource SectionTitle}" Margin="0,12,0,4"/>
                                        <DataGrid x:Name="gridIntAssign" Style="{StaticResource DarkDataGrid}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                                  SelectionMode="Extended" MinHeight="40" MaxHeight="190">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Ziel" Binding="{Binding Ziel}" Width="2*"/>
                                                <DataGridTextColumn Header="Absicht" Binding="{Binding Absicht}" Width="120"/>
                                                <DataGridTextColumn Header="Hinweise" Binding="{Binding Hinweise}" Width="110"/>
                                                <DataGridTextColumn Header="Frist" Binding="{Binding Frist}" Width="110"/>
                                                <DataGridTextColumn Header="Tenants" Binding="{Binding Tenants}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <WrapPanel Margin="0,6,0,0">
                                            <ComboBox x:Name="cmbIntTarget" Style="{StaticResource DarkComboBox}" Width="140" Margin="0,0,4,4">
                                                <ComboBoxItem Content="Gruppe" Tag="group" IsSelected="True"/>
                                                <ComboBoxItem Content="Gruppe ausschliessen" Tag="exclude"/>
                                                <ComboBoxItem Content="Alle Geraete" Tag="allDevices"/>
                                                <ComboBoxItem Content="Alle Benutzer" Tag="allUsers"/>
                                            </ComboBox>
                                            <TextBox x:Name="txtIntGroup" Style="{StaticResource DarkTextBox}" Width="190" Margin="0,0,2,4" ToolTip="Gruppenname - wird je Tenant gesucht"/>
                                            <Button x:Name="btnIntGroupPick" Content="&#x1F50D;" Style="{StaticResource ToolButton}" FontSize="11" Padding="6,1" Margin="0,0,4,4"/>
