<!--
    HU-MultiTenant - Berechtigungen: erteilte Graph-Anwendungsberechtigungen je Tenant,
    benoetigte Berechtigungen der gewaehlten Extension, Vergleich aller Tenants.
-->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Berechtigungen"
    Width="980" Height="660" MinWidth="720" MinHeight="420"
    WindowStartupLocation="CenterOwner"
    Background="#1E1E1E"
    UseLayoutRounding="True"
    ShowInTaskbar="False"
    ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!--HU:THEME-->
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- Kopf: Tenant-Auswahl -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Tenant:" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="cmbTenant" Width="260" Style="{StaticResource DarkComboBox}" Margin="0,0,8,0"/>
            <Button x:Name="btnReload" Content="&#x21BB; Neu lesen" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                    ToolTip="Token neu holen (z. B. nach Administratorzustimmung in Entra)"/>
            <Button x:Name="btnCompare" Content="Alle Tenants vergleichen" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                    ToolTip="Welche Berechtigung ist in welchem Tenant erteilt"/>
            <TextBlock x:Name="txtStatus" Foreground="#858585" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- Fuss -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="txtHint" Style="{StaticResource HintText}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="560"
                       Text="Fehlt etwas: Entra Admin Center &#x203A; App-Registrierung &#x203A; API-Berechtigungen &#x203A; Microsoft Graph &#x203A; Anwendungsberechtigungen hinzuf&#xFC;gen &#x203A; Administratorzustimmung erteilen &#x203A; hier &#x21BB; Neu lesen."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnEntra" Content="App im Entra Admin Center" Background="#1976D2" Style="{StaticResource DarkButton}" Margin="0,0,8,0"/>
                <Button x:Name="btnClose" Content="Schlie&#xDF;en" Background="#555555" Style="{StaticResource DarkButton}" IsCancel="True"/>
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Benoetigt von der gewaehlten Extension -->
            <TextBlock x:Name="lblNeeded" Grid.Row="0" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
            <DataGrid x:Name="gridNeeded" Grid.Row="1" Style="{StaticResource DarkDataGrid}" AutoGenerateColumns="False"
                      IsReadOnly="True" MaxHeight="170" Margin="0,0,0,10" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Berechtigung" Binding="{Binding Berechtigung}" Width="2*"/>
                    <DataGridTextColumn Header="Risiko" Binding="{Binding Risiko}" Width="80"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                    <DataGridTextColumn Header="Beschreibung" Binding="{Binding Beschreibung}" Width="3*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Erteilt / Vergleich -->
            <TextBlock x:Name="lblGranted" Grid.Row="2" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
            <DataGrid x:Name="gridGranted" Grid.Row="3" Style="{StaticResource DarkDataGrid}" AutoGenerateColumns="True"
                      IsReadOnly="True" HeadersVisibility="Column"/>
        </Grid>
    </DockPanel>
</Window>
