<!--
    HU-MultiTenant - Berechtigungen: erteilte Graph-Anwendungsberechtigungen je Tenant,
    benoetigte Berechtigungen der gewaehlten Extension, Vergleich aller Tenants.
-->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Berechtigungen"
    Width="1500" Height="860" MinWidth="900" MinHeight="480"
    WindowStartupLocation="CenterOwner"
    Background="#1E1E1E"
    UseLayoutRounding="True"
    ShowInTaskbar="False"
    ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!--HU:THEME-->
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- Kopf: Tenant-Auswahl -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Tenant:" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="cmbTenant" Width="260" Style="{StaticResource DarkComboBox}" Margin="0,0,8,0"/>
            <Button x:Name="btnReload" Content="&#x21BB; Neu lesen" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                    ToolTip="Token neu holen (z. B. nach Administratorzustimmung in Entra)"/>
            <Button x:Name="btnCompare" Content="Alle Tenants vergleichen" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                    ToolTip="Welche Berechtigung ist in welchem Tenant erteilt"/>
            <TextBlock x:Name="txtStatus" Foreground="#858585" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- Fuss -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
                <Button x:Name="btnWriteOn" Height="30" VerticalAlignment="Center" Content="&#x270E; Entra-Schreibrechte an ..." Background="#A65A28" Style="{StaticResource DarkButton}" Margin="0,4,8,0" ToolTipService.ShowOnDisabled="True"
                        ToolTip="Nur diese 4 Rechte fuer Entra uebertragen/zurueckschreiben, nur fuer diesen Tenant:&#x0a;Policy.ReadWrite.ConditionalAccess&#x0a;Policy.ReadWrite.Authorization&#x0a;Policy.ReadWrite.ConsentRequest&#x0a;GroupSettings.ReadWrite.All&#x0a;&#x0a;Andere Schreibrechte (Intune, Benutzer, Apps) bleiben unberuehrt. Nach der Arbeit wieder ausschalten."/>
                <Button x:Name="btnWriteOff" Height="30" VerticalAlignment="Center" Content="Entra-Schreibrechte aus ..." Background="#555555" Style="{StaticResource DarkButton}" Margin="0,4,8,0" ToolTipService.ShowOnDisabled="True"
                        ToolTip="Genau diese 4 Rechte wieder entziehen (Admin-Anmeldung im Browser):&#x0a;Policy.ReadWrite.ConditionalAccess&#x0a;Policy.ReadWrite.Authorization&#x0a;Policy.ReadWrite.ConsentRequest&#x0a;GroupSettings.ReadWrite.All&#x0a;&#x0a;Andere Schreibrechte (Intune, Benutzer, Apps) bleiben."/>
                <Button x:Name="btnGrant" Height="30" VerticalAlignment="Center" Content="Fehlende Rechte erteilen ..." Background="#2E7D32" Style="{StaticResource DarkButton}" Margin="0,4,8,0"
                        ToolTip="Admin-Anmeldung im Browser: fehlende Rechte (Standard, Extensions, eigene) der App erteilen"/>
                <Button x:Name="btnEntra" Height="30" VerticalAlignment="Center" Content="App im Entra Admin Center" Background="#1976D2" Style="{StaticResource DarkButton}" Margin="0,4,8,0"/>
                <Button x:Name="btnClose" Height="30" VerticalAlignment="Center" Margin="0,4,0,0" Content="Schlie&#xDF;en" Background="#555555" Style="{StaticResource DarkButton}" IsCancel="True"/>
            </WrapPanel>
            <TextBlock x:Name="txtHint" Style="{StaticResource HintText}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Fehlt etwas: &#x201E;Fehlende Rechte erteilen &#x2026;&#x201C; (Admin-Anmeldung im Browser) - oder von Hand: Entra Admin Center &#x203A; App-Registrierung &#x203A; API-Berechtigungen &#x203A; Microsoft Graph &#x203A; Anwendungsberechtigungen hinzuf&#xFC;gen &#x203A; Administratorzustimmung erteilen &#x203A; hier &#x21BB; Neu lesen."/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Benoetigt von der gewaehlten Extension -->
            <TextBlock x:Name="lblNeeded" Grid.Row="0" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
            <DataGrid x:Name="gridNeeded" Grid.Row="1" Style="{StaticResource DarkDataGrid}" AutoGenerateColumns="False"
                      IsReadOnly="True" MaxHeight="170" Margin="0,0,0,10" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Berechtigung" Binding="{Binding Berechtigung}" Width="2*"/>
                    <DataGridTextColumn Header="Risiko" Binding="{Binding Risiko}" Width="Auto" MinWidth="80"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" MinWidth="110"/>
                    <DataGridTextColumn Header="Beschreibung" Binding="{Binding Beschreibung}" Width="3*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Erteilt / Vergleich -->
            <TextBlock x:Name="lblGranted" Grid.Row="2" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
            <DataGrid x:Name="gridGranted" Grid.Row="3" Style="{StaticResource DarkDataGrid}" AutoGenerateColumns="True"
                      IsReadOnly="True" HeadersVisibility="Column"/>
        </Grid>
    </DockPanel>
</Window>
